{
  "name": "kitverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "catalog:build": "python3 tools/catalog-build/build_catalog.py catalog",
    "chat": "tsx --conditions=react-server scripts/chat.ts",
    "style:import": "tsx --conditions=react-server scripts/import-style.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "staff:invite": "tsx scripts/invite-staff.ts",
    "db:clean-tests": "tsx scripts/clean-test-data.ts",
    "photos:screen": "tsx --conditions=react-server scripts/screen-photos.ts",
    "photos:verify-teams": "tsx --conditions=react-server scripts/verify-photo-teams.ts",
    "store:export": "tsx scripts/export-store-catalog.ts",
    "prebuild": "tsx scripts/export-store-catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "inngest": "^4.21.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
