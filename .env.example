# KitVerse — environment variable names. Copy to .env.local (gitignored) and
# fill in. Commit THIS file: names only, never values. Set every variable in
# both the Preview and Production environments of the host.
#
# The site builds and runs with none of these set. Checkout offers only the
# payment methods whose credentials are present; with none of the three
# configured it shows a "payments not configured" panel rather than breaking.

# --- Site ---
NEXT_PUBLIC_SITE_URL=            # production origin (https://…) — the ONLY place the domain lives; getSiteUrl() reads it

# --- PayPlus (primary — card payments) ---
# All three must be set for the card method to appear at checkout. Nothing
# here is ever NEXT_PUBLIC_: the browser never talks to PayPlus, it is only
# redirected to a hosted page this server asked for.
PAYPLUS_API_KEY=                 # server-only — per environment (the sandbox key is not the production key)
PAYPLUS_SECRET_KEY=              # server-only — also the HMAC key that authenticates callbacks
PAYPLUS_PAYMENT_PAGE_UID=        # server-only — the hosted payment page this store charges through
PAYPLUS_ENV=sandbox              # sandbox | live — MUST be live only in Production

# --- PayPal (secondary — international) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # public client id — the only PayPal value the browser may see
PAYPAL_SECRET=                   # server-only
PAYPAL_WEBHOOK_ID=               # server-only — required to verify webhook signatures
PAYPAL_ENV=sandbox               # sandbox | live — MUST be live only in Production

# --- Cash on delivery (Bit deposit) ---
# The owner's Bit-registered phone number. Set it and the cash-on-delivery
# method appears at checkout; leave it blank and the method does not exist —
# it is not offered, and /api/checkout/bit/start answers 503.
#
# NEVER NEXT_PUBLIC_. This is a real personal number: it is read server-side
# only, and reaches a browser in exactly one place — rendered into the
# confirmation page of an order that has just been placed by the buyer who now
# has to pay it. There is no Bit API and no key: the buyer sends the deposit by
# hand and the owner marks the order paid in the Supabase dashboard.
BIT_PHONE_NUMBER=                # server-only, e.g. 05X-XXXXXXX

# --- Supabase (orders) ---
SUPABASE_URL=                    # project URL
SUPABASE_SERVICE_ROLE_KEY=       # server-only, never NEXT_PUBLIC_ — orders are written only from server routes

# --- Email (order notifications) ---
# All three must be set for an email to go out. With any of them missing the
# order summary is written to the server log instead — a paid order is never
# failed because a notification could not be sent.
RESEND_API_KEY=                  # server-only
ORDER_NOTIFY_EMAIL=              # where a paid order is announced (the store owner)
ORDER_NOTIFY_FROM=               # verified Resend sender, e.g. orders@<your-domain>

# --- Webhook registration (before go-live) ---
# PayPal: register <site>/api/paypal/webhook for the event
# PAYMENT.CAPTURE.COMPLETED, then copy the webhook id the dashboard shows into
# PAYPAL_WEBHOOK_ID above. The route verifies every delivery against PayPal
# before believing it.
#
# PayPlus: no dashboard registration is needed — the callback URL is sent with
# each payment page (refURL_callback = <site>/api/payplus/webhook). The route
# authenticates every delivery by HMAC and then asks PayPlus directly what
# happened before it believes anything.
