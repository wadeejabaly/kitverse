{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "jobs",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "inngest-cli@latest",
        "dev",
        "-u",
        "http://localhost:3000/api/inngest",
        "--no-discovery"
      ],
      "port": 8288
    }
  ]
}